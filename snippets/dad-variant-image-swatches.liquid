{% comment %}
  Do-A-Dot custom variant picker — image swatches.

  Renders each variant's featured_image as a clickable thumbnail swatch
  with the variant name underneath. Works for single-option products
  (e.g. the consolidated Dot Markers product with its "Color Set" option).

  Multi-option products fall back to Dawn's standard picker so things
  like color + size combos still work.

  Accepts:
  - product: {Object}
  - block: {Object}
  - product_form_id: {String}

  Usage:
  {% render 'dad-variant-image-swatches', product: product, block: block, product_form_id: product_form_id %}
{% endcomment %}

{%- unless product.has_only_default_variant -%}
  {%- if product.options.size == 1 -%}
    <variant-selects
      id="variant-selects-{{ section.id }}"
      data-section="{{ section.id }}"
      {{ block.shopify_attributes }}
    >
      {%- assign option = product.options_with_values.first -%}
      <fieldset class="js product-form__input dad-variant-image-swatches">
        <legend class="form__label">
          {{ option.name }}:
          <span data-selected-value>{{- option.selected_value -}}</span>
        </legend>
        {{ 'component-slider.css' | asset_url | stylesheet_tag }}
        <slider-component class="dad-variant-swatch-slider slider-mobile-gutter">
          <ul
            id="Slider-variant-{{ section.id }}"
            class="dad-variant-image-swatches__grid grid grid--3-col-desktop grid--2-col-tablet-down slider slider--mobile grid--peek"
            role="list"
            aria-label="{{ option.name }}"
          >
          {%- for variant in product.variants -%}
            {%- assign label_id = section.id | append: '-dad-swatch-' | append: forloop.index -%}
            <li id="Slide-variant-{{ section.id }}-{{ forloop.index }}" class="grid__item slider__slide">
            <label
              class="dad-variant-image-swatch
                {%- if variant == product.selected_or_first_available_variant %} is-selected{% endif %}
                {%- unless variant.available %} is-unavailable{% endunless %}"
              for="{{ label_id }}"
            >
              <input
                type="radio"
                id="{{ label_id }}"
                name="options[{{ option.name | escape }}]"
                value="{{ variant.option1 | escape }}"
                form="{{ product_form_id }}"
                data-product-url="{{ variant.url }}"
                data-option-value-id="{{ variant.id }}"
                {% if variant == product.selected_or_first_available_variant %}checked{% endif %}
              >
              <span class="dad-variant-image-swatch__media">
                {%- if variant.featured_image != blank -%}
                  {%- comment -%}
                    Swatches render up to ~165px wide on mobile (2-up) and are
                    magnified by transform:scale(1.4) in CSS, so the painted
                    area needs ~230px of image. srcset + a zoom-inflated sizes
                    value (≈ box width × 1.4) lets the browser pull a
                    DPR-appropriate source; width:825 is the crisp upper bound
                    for 3× phones.
                  {%- endcomment -%}
                  {{
                    variant.featured_image
                    | image_url: width: 825
                    | image_tag:
                      widths: '165, 248, 330, 412, 550, 660, 825',
                      width: 165,
                      height: 165,
                      alt: variant.title,
                      loading: 'lazy',
                      sizes: '(min-width: 750px) 200px, 62vw',
                      class: 'dad-variant-image-swatch__img'
                  }}
                {%- else -%}
                  <span class="dad-variant-image-swatch__placeholder" aria-hidden="true"></span>
                {%- endif -%}
              </span>
              <span class="dad-variant-image-swatch__name">{{ variant.option1 }}</span>
              {%- unless variant.available -%}
                <span class="dad-variant-image-swatch__badge">
                  {{- 'products.product.variant_sold_out_or_unavailable' | t -}}
                </span>
              {%- endunless -%}
            </label>
            </li>
          {%- endfor -%}
          </ul>
          <div class="slider-buttons dad-variant-swatch-slider__buttons">
            <button
              type="button"
              class="slider-button slider-button--prev"
              name="previous"
              aria-label="{{ 'general.slider.previous_slide' | t }}"
              aria-controls="Slider-variant-{{ section.id }}"
            >
              <span class="svg-wrapper">{{- 'icon-caret.svg' | inline_asset_content -}}</span>
            </button>
            <div class="slider-counter caption">
              <span class="slider-counter--current">1</span>
              <span aria-hidden="true"> / </span>
              <span class="visually-hidden">{{ 'general.slider.of' | t }}</span>
              <span class="slider-counter--total">{{ product.variants.size }}</span>
            </div>
            <button
              type="button"
              class="slider-button slider-button--next"
              name="next"
              aria-label="{{ 'general.slider.next_slide' | t }}"
              aria-controls="Slider-variant-{{ section.id }}"
            >
              <span class="svg-wrapper">{{- 'icon-caret.svg' | inline_asset_content -}}</span>
            </button>
          </div>
        </slider-component>
      </fieldset>
    </variant-selects>
  {%- else -%}
    {%- comment -%}
      Multi-option products — fall back to Dawn's standard picker.
      That handles dropdowns/pills/native swatches for color + size combos.
    {%- endcomment -%}
    {% render 'product-variant-picker',
      product: product,
      block: block,
      product_form_id: product_form_id
    %}
  {%- endif -%}
{%- endunless -%}
