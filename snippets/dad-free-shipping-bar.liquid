{%- comment -%}
  Do-A-Dot free shipping progress bar — rendered at the top of the cart
  drawer and cart page. Both re-render via the Section Rendering API on
  cart changes, so the bar stays current without extra JS.

  The threshold lives in theme settings (Cart group) and must match the
  free shipping rate in Settings > Shipping and delivery. Set to 0 to hide.

  Usage:
  {% render 'dad-free-shipping-bar' %}
  {% render 'dad-free-shipping-bar', context: 'page' %}
{%- endcomment -%}

{%- liquid
  assign dad_fs_threshold = settings.free_shipping_threshold | default: 55 | times: 100
-%}
{%- if cart != empty and dad_fs_threshold > 0 -%}
  {%- liquid
    assign dad_fs_remaining = dad_fs_threshold | minus: cart.total_price
    assign dad_fs_progress = cart.total_price | times: 100.0 | divided_by: dad_fs_threshold | at_most: 100 | round
  -%}
  <div class="dad-ship-progress{% if context == 'page' %} dad-ship-progress--page{% endif %}" role="status">
    {%- if dad_fs_remaining > 0 -%}
      <p class="dad-ship-progress__label">
        You're <strong>{{ dad_fs_remaining | money_without_trailing_zeros }} away</strong> from free shipping
      </p>
    {%- else -%}
      <p class="dad-ship-progress__label">&#127881; you've unlocked <strong>free shipping</strong></p>
    {%- endif -%}
    <div class="dad-ship-progress__track">
      <span class="dad-ship-progress__fill" style="width: {{ dad_fs_progress }}%"></span>
    </div>
  </div>
{%- endif -%}
