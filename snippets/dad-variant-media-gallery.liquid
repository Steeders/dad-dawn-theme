{% comment %}
  dad-variant-media-gallery

  Per-variant image gallery driven by the variant metafield
  `custom.variant_images` (list.file_reference -> images). Rendered in place of
  Dawn's `product-media-gallery` when the selected variant has variant_images
  (guarded in sections/main-product.liquid).

  Only the SELECTED variant's images are rendered server-side. Variant switching
  is handled by assets/dad-variant-gallery.js, which swaps this gallery's
  [data-vg-content] using the section HTML Dawn already fetches on variant
  change (PUB_SUB variantChange). No dependency on Dawn's media-gallery.js.

  Accepts:
  - product:    {Object} Product liquid object
  - section_id: {String} The host section id (for variantChange targeting)
{% endcomment %}

{%- liquid
  assign current_variant = product.selected_or_first_available_variant
  assign images = current_variant.metafields.custom.variant_images.value
-%}

<dad-variant-gallery class="dad-vg{% if sticky %} product__column-sticky{% endif %}" data-section-id="{{ section_id }}">
  <div data-vg-content>
    {%- if images != blank and images.size > 0 -%}
      <div class="dad-vg__main">
        {%- for media_item in images -%}
          {%- liquid
            assign img_loading = 'lazy'
            if forloop.first
              assign img_loading = 'eager'
            endif
          -%}
          <div
            class="dad-vg__slide{% if forloop.first %} is-active{% endif %}"
            data-vg-slide="{{ forloop.index0 }}"
          >
            {%- if media_item.media_type == 'video' -%}
              <deferred-media class="deferred-media dad-vg__deferred" data-media-id="{{ media_item.id }}">
                <button id="Deferred-Poster-DadVg-{{ media_item.id }}" class="deferred-media__poster" type="button">
                  <span class="deferred-media__poster-button motion-reduce">
                    <span class="visually-hidden">{{ 'products.product.media.play_video' | t }}</span>
                    <span class="svg-wrapper">
                      {{- 'icon-play.svg' | inline_asset_content -}}
                    </span>
                  </span>
                  {{
                    media_item.preview_image
                    | image_url: width: 1500
                    | image_tag:
                      loading: img_loading,
                      sizes: '(min-width: 990px) 50vw, 100vw',
                      widths: '300, 500, 750, 1000, 1250, 1500',
                      class: 'dad-vg__img',
                      alt: media_item.alt
                  }}
                </button>
                <template>
                  {%- comment -%}
                    Manual <video> instead of video_tag so browsers that can't
                    play HLS (Chrome/Firefox) fall through to the 720p MP4
                    rather than the 7.2Mbps 1080p one — ~40% lighter, looks
                    identical at gallery size. Safari picks the adaptive HLS.
                  {%- endcomment -%}
                  <video
                    class="dad-vg__video"
                    controls
                    autoplay
                    playsinline
                    preload="none"
                    poster="{{ media_item.preview_image | image_url: width: 1500 }}"
                    aria-label="{{ media_item.alt | escape }}"
                  >
                    {%- for source in media_item.sources -%}
                      {%- if source.format == 'm3u8' -%}
                        <source src="{{ source.url }}" type="{{ source.mime_type }}">
                      {%- endif -%}
                    {%- endfor -%}
                    {%- assign mp4_sources = media_item.sources | where: 'format', 'mp4' | sort: 'height' -%}
                    {%- for source in mp4_sources -%}
                      {%- if source.height >= 720 or forloop.last -%}
                        <source src="{{ source.url }}" type="{{ source.mime_type }}">
                      {%- endif -%}
                    {%- endfor -%}
                  </video>
                </template>
              </deferred-media>
            {%- else -%}
              {{
                media_item
                | image_url: width: 1500
                | image_tag:
                  loading: img_loading,
                  sizes: '(min-width: 990px) 50vw, 100vw',
                  widths: '300, 500, 750, 1000, 1250, 1500',
                  class: 'dad-vg__img',
                  alt: media_item.alt
              }}
            {%- endif -%}
          </div>
        {%- endfor -%}

        {%- if images.size > 1 -%}
          <button type="button" class="dad-vg__arrow dad-vg__arrow--prev" data-vg-prev aria-label="{{ 'general.slider.previous_slide' | t }}">
            <span class="svg-wrapper">{{- 'icon-caret.svg' | inline_asset_content -}}</span>
          </button>
          <button type="button" class="dad-vg__arrow dad-vg__arrow--next" data-vg-next aria-label="{{ 'general.slider.next_slide' | t }}">
            <span class="svg-wrapper">{{- 'icon-caret.svg' | inline_asset_content -}}</span>
          </button>
        {%- endif -%}
      </div>

      {%- if images.size > 1 -%}
        <ul class="dad-vg__thumbs list-unstyled" role="list">
          {%- for media_item in images -%}
            <li>
              <button
                type="button"
                class="dad-vg__thumb{% if forloop.first %} is-active{% endif %}"
                data-vg-thumb="{{ forloop.index0 }}"
                {% if forloop.first %}aria-current="true"{% endif %}
                aria-label="{{ 'products.product.media.load_image' | t: index: forloop.index }}"
              >
                {%- if media_item.media_type == 'video' -%}
                  {{
                    media_item.preview_image
                    | image_url: width: 200
                    | image_tag:
                      loading: 'lazy',
                      sizes: '100px',
                      widths: '100, 200',
                      alt: media_item.alt
                  }}
                  <span class="dad-vg__thumb-play">{{- 'icon-play.svg' | inline_asset_content -}}</span>
                {%- else -%}
                  {{
                    media_item
                    | image_url: width: 200
                    | image_tag:
                      loading: 'lazy',
                      sizes: '100px',
                      widths: '100, 200',
                      alt: media_item.alt
                  }}
                {%- endif -%}
              </button>
            </li>
          {%- endfor -%}
        </ul>
      {%- endif -%}
    {%- endif -%}
  </div>
</dad-variant-gallery>
