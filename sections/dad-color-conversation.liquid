{%- comment -%}
  DAD COLOR CONVERSATION — Do-A-Dot Art
  Eyebrow / display heading / lede + "see the full color story" link,
  followed by the 12 named-color swatch row (the "conversation through color" hook).
  New section — update-safe. Colors come from the named-swatch tokens in dad-tokens.css.
{%- endcomment -%}

{%- comment -%} 12 named colors — order, token slug, and on-dark flag (1 = light text). {%- endcomment -%}
{%- assign sw_labels = "piggy pink,flamingo fuchsia,lady bug red,tiger tail orange,goldfish gold,froggy green,dragonfly teal,butterfly blue,peacock blue,lavender lullaby,octopus purple,kitty cat black" | split: "," -%}
{%- assign sw_vars = "piggy-pink,flamingo-fuchsia,ladybug-red,tiger-tail-orange,goldfish-gold,froggy-green,dragonfly-teal,butterfly-blue,peacock-blue,lavender-lullaby,octopus-purple,kitty-cat-black" | split: "," -%}
{%- assign sw_dark = "0,1,1,1,0,1,1,0,1,0,1,1" | split: "," -%}

<div
  class="dad-cc color-{{ section.settings.color_scheme }}"
  style="padding-top: {{ section.settings.padding_top }}px; padding-bottom: {{ section.settings.padding_bottom }}px;"
>
  <div class="dad-cc__inner">
    <div class="dad-cc__head">
      <div class="dad-cc__copy">
        {%- if section.settings.eyebrow != blank -%}
          <span class="dad-eyebrow">{{ section.settings.eyebrow }}</span>
        {%- endif -%}
        {%- if section.settings.heading != blank -%}
          <h2 class="dad-cc__title">{{ section.settings.heading }}</h2>
        {%- endif -%}
        {%- if section.settings.body != blank -%}
          <div class="dad-cc__body rte">{{ section.settings.body }}</div>
        {%- endif -%}
      </div>
      {%- if section.settings.cta_label != blank -%}
        <a class="dad-cc__seeall" href="{{ section.settings.cta_link | default: '#' }}">
          {{ section.settings.cta_label }}
          <svg viewBox="0 0 16 16" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 8h10M9 4l4 4-4 4"/></svg>
        </a>
      {%- endif -%}
    </div>

    <div class="dad-cc__palette">
      {%- for label in sw_labels -%}
        {%- assign i = forloop.index0 -%}
        {%- assign var = sw_vars[i] -%}
        <div class="dad-cc__swatch{% if sw_dark[i] == '1' %} is-on-dark{% endif %}" style="background: var(--dad-{{ var }});">
          <span class="dad-cc__num">{% if forloop.index < 10 %}0{% endif %}{{ forloop.index }}</span>
          <span class="dad-cc__name">{{ label | downcase }}</span>
        </div>
      {%- endfor -%}
    </div>
  </div>
</div>

{% stylesheet %}
.dad-cc { padding-left: var(--s-5); padding-right: var(--s-5); }
.dad-cc__inner { max-width: 1200px; margin: 0 auto; }

.dad-cc__head { display: flex; align-items: flex-end; justify-content: space-between; gap: var(--s-6); margin-bottom: var(--s-8); }
.dad-cc__copy { max-width: 44ch; }
.dad-cc__title { font-family: var(--font-display); font-weight: 400; font-size: var(--fs-display); line-height: var(--lh-tight); color: var(--dad-ink); margin: var(--s-2) 0 0; }
.dad-cc__body { font-family: var(--font-body); font-weight: 500; font-size: var(--fs-body); line-height: var(--lh-normal); color: var(--dad-ink-muted); margin-top: var(--s-3); max-width: 46ch; }
.dad-cc__body p { margin: 0; }

.dad-cc__seeall { flex-shrink: 0; align-self: flex-end; display: inline-flex; align-items: center; gap: var(--s-1); font-family: var(--font-body); font-weight: 700; font-size: var(--fs-small); color: var(--dad-ink); text-decoration: none; border-bottom: 1.5px solid var(--dad-ink); padding-bottom: 2px; white-space: nowrap; }
.dad-cc__seeall:hover { color: var(--dad-hot-pink); border-color: var(--dad-hot-pink); }

.dad-cc__palette { display: grid; grid-template-columns: repeat(12, 1fr); gap: var(--s-3); }
.dad-cc__swatch { aspect-ratio: 3 / 4; border-radius: var(--r-md); padding: var(--s-3); display: flex; flex-direction: column; justify-content: space-between; color: var(--dad-ink); border: 1px solid var(--border); }
.dad-cc__swatch.is-on-dark { color: var(--dad-cream); }
.dad-cc__num { font-family: var(--font-display); font-size: var(--fs-body); opacity: 0.7; }
.dad-cc__name { font-family: var(--font-display); font-size: var(--fs-body); line-height: 1; text-transform: lowercase; }

@media screen and (max-width: 989px) {
  .dad-cc__palette { grid-template-columns: repeat(6, 1fr); }
}
@media screen and (max-width: 749px) {
  .dad-cc__head { flex-direction: column; align-items: flex-start; gap: var(--s-4); }
  .dad-cc__seeall { align-self: flex-start; }
}
@media screen and (max-width: 480px) {
  .dad-cc__palette { grid-template-columns: repeat(3, 1fr); gap: var(--s-2); }
  .dad-cc__swatch { aspect-ratio: 1; padding: var(--s-2); }
}
{% endstylesheet %}

{% schema %}
{
  "name": "DAD color conversation",
  "tag": "section",
  "class": "dad-color-conversation-section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "conversation through color" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Every color has a name. Every name starts a story." },
    { "type": "richtext", "id": "body", "label": "Body", "default": "<p>Piggy Pink. Tiger Tail Orange. Octopus Purple. We name our colors after the world around your kid — so picking one is the start of a conversation, not just a stroke.</p>" },
    { "type": "text", "id": "cta_label", "label": "Button label", "default": "see the full color story" },
    { "type": "url", "id": "cta_link", "label": "Button link" },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-1" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 160, "step": 4, "unit": "px", "label": "Top padding", "default": 96 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 160, "step": 4, "unit": "px", "label": "Bottom padding", "default": 96 }
  ],
  "presets": [ { "name": "DAD color conversation" } ]
}
{% endschema %}
