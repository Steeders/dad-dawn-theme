{%- comment -%}
  DAD CUSTOM HEADER — Do-A-Dot Art
  Menu-driven header (reads section.settings.menu). Graza-style mega menu:
    - The top-level item matching `mega_item` (default "Shop") opens a
      full-width mega menu. Its child GROUPS render as text-link columns,
      EXCEPT the group matching `featured_group` (default "Featured"), which
      renders as a row of image cards with captions (images auto-resolved
      from each linked collection/product).
    - Other top-level items with children render as a dropdown (Resources).
    - A leaf top-level item renders as a plain link.
  New section — Dawn's stock header.liquid is untouched. Tokens: dad-tokens.css.
{%- endcomment -%}

{%- liquid
  assign main = linklists[section.settings.menu]
  assign mega_title = section.settings.mega_item | default: 'Shop'
  assign featured_title = section.settings.featured_group | default: 'Featured'
-%}

<dad-header class="dad-header" data-sticky="{{ section.settings.enable_sticky }}">
  <div class="dad-header__bar">
    <button type="button" class="dad-header__icon dad-header__burger" aria-label="Open menu" aria-expanded="false" data-drawer-toggle>
      <svg viewBox="0 0 24 24" width="26" height="26" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" aria-hidden="true">
        <line x1="3" y1="6" x2="21" y2="6"/><line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="18" x2="21" y2="18"/>
      </svg>
    </button>

    <a href="{{ routes.root_url }}" class="dad-header__logo" aria-label="{{ shop.name | escape }} — home">
      {%- if section.settings.logo != blank -%}
        {{ section.settings.logo | image_url: width: 600 | image_tag:
          loading: 'eager', widths: '200, 300, 400, 600',
          sizes: '(max-width: 749px) 140px, 200px', alt: shop.name,
          class: 'dad-header__logo-img', style: 'max-width: 100%; width: auto;' }}
      {%- else -%}
        <span class="dad-header__logo-text">{{ shop.name }}</span>
      {%- endif -%}
    </a>

    <nav class="dad-header__nav" aria-label="Primary">
      {%- for link in main.links -%}
        {%- if link.title == mega_title and link.links.size > 0 -%}
          <div class="dad-header__nav-item" data-nav-item>
            <button type="button" class="dad-header__nav-link" aria-expanded="false" aria-controls="dad-mega-shop" data-nav-trigger>
              {{ link.title }}
              <svg class="dad-header__caret" viewBox="0 0 12 8" width="12" height="8" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M1 1l5 5 5-5"/></svg>
            </button>
            <div class="dad-mega" id="dad-mega-shop" data-nav-panel hidden>
              <div class="dad-mega__inner">
                <div class="dad-mega__layout">
                  <div class="dad-mega__cols">
                    {%- for group in link.links -%}
                      {%- if group.title != featured_title and group.links.size > 0 -%}
                        <div class="dad-mega__col">
                          <p class="dad-mega__col-title">{{ group.title }}</p>
                          <ul class="dad-mega__sublist">
                            {%- for sub in group.links -%}
                              <li><a href="{{ sub.url }}">{{ sub.title }}</a></li>
                            {%- endfor -%}
                          </ul>
                        </div>
                      {%- endif -%}
                    {%- endfor -%}
                  </div>

                  {%- for group in link.links -%}
                    {%- if group.title == featured_title and group.links.size > 0 -%}
                      <div class="dad-mega__featured">
                        <p class="dad-mega__col-title">{{ group.title }}</p>
                        <div class="dad-mega__featured-row">
                          {%- for item in group.links -%}
                            {%- liquid
                              assign fimg = null
                              assign fobj = item.object
                              if item.type == 'collection_link' and fobj != blank
                                if fobj.image != blank
                                  assign fimg = fobj.image
                                elsif fobj.products.first != blank
                                  assign fimg = fobj.products.first.featured_image
                                endif
                              elsif item.type == 'product_link' and fobj != blank
                                assign fimg = fobj.featured_image
                              endif
                            -%}
                            <a class="dad-mega__fcard" href="{{ item.url }}">
                              <span class="dad-mega__fcard-media">
                                {%- if fimg != blank -%}
                                  {{ fimg | image_url: width: 360 | image_tag:
                                    loading: 'lazy', widths: '160, 260, 360', sizes: '200px',
                                    alt: item.title, class: 'dad-mega__fcard-img' }}
                                {%- endif -%}
                              </span>
                              <span class="dad-mega__fcard-cap">{{ item.title }}</span>
                            </a>
                          {%- endfor -%}
                        </div>
                      </div>
                    {%- endif -%}
                  {%- endfor -%}
                </div>
              </div>
            </div>
          </div>
        {%- elsif link.links.size > 0 -%}
          <div class="dad-header__nav-item" data-nav-item>
            <button type="button" class="dad-header__nav-link" aria-expanded="false" aria-controls="dad-dd-{{ forloop.index0 }}" data-nav-trigger>
              {{ link.title }}
              <svg class="dad-header__caret" viewBox="0 0 12 8" width="12" height="8" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M1 1l5 5 5-5"/></svg>
            </button>
            <div class="dad-dropdown" id="dad-dd-{{ forloop.index0 }}" data-nav-panel hidden>
              <ul class="dad-dropdown__list">
                {%- for sub in link.links -%}
                  <li><a href="{{ sub.url }}">{{ sub.title }}</a></li>
                {%- endfor -%}
              </ul>
            </div>
          </div>
        {%- else -%}
          <a class="dad-header__nav-link dad-header__nav-link--plain" href="{{ link.url }}">{{ link.title }}</a>
        {%- endif -%}
      {%- endfor -%}
    </nav>

    <div class="dad-header__actions">
      {%- if section.settings.show_search -%}
        <a href="{{ routes.search_url }}" class="dad-header__icon" aria-label="Search">
          <svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="11" cy="11" r="7"/><line x1="21" y1="21" x2="16.5" y2="16.5"/></svg>
        </a>
      {%- endif -%}
      <a href="{{ routes.cart_url }}" class="dad-header__icon dad-header__cart" aria-label="Cart">
        <svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 6h15l-1.5 9h-12z"/><circle cx="9" cy="20" r="1.4"/><circle cx="18" cy="20" r="1.4"/><path d="M6 6L5 2H2"/></svg>
        <span class="dad-header__cart-count{% if cart.item_count == 0 %} is-empty{% endif %}" data-cart-count>{{ cart.item_count }}</span>
      </a>
    </div>
  </div>

  {%- comment -%} Mobile drawer (menu-driven) {%- endcomment -%}
  <div class="dad-drawer" data-drawer hidden>
    <div class="dad-drawer__overlay" data-drawer-close></div>
    <aside class="dad-drawer__panel" role="dialog" aria-label="Menu">
      <button type="button" class="dad-header__icon dad-drawer__close" aria-label="Close menu" data-drawer-close>
        <svg viewBox="0 0 24 24" width="26" height="26" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" aria-hidden="true"><line x1="5" y1="5" x2="19" y2="19"/><line x1="19" y1="5" x2="5" y2="19"/></svg>
      </button>
      <nav class="dad-drawer__nav" aria-label="Mobile">
        {%- for link in main.links -%}
          {%- if link.links.size > 0 -%}
            <div class="dad-drawer__group">
              <button type="button" class="dad-drawer__toggle" aria-expanded="false" data-drawer-sub>{{ link.title }}
                <svg viewBox="0 0 12 8" width="12" height="8" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M1 1l5 5 5-5"/></svg>
              </button>
              <div class="dad-drawer__sub" hidden>
                {%- for child in link.links -%}
                  {%- if child.links.size > 0 -%}
                    {%- for sub in child.links -%}
                      <a class="dad-drawer__link" href="{{ sub.url }}">{{ sub.title }}</a>
                    {%- endfor -%}
                  {%- else -%}
                    <a class="dad-drawer__link" href="{{ child.url }}">{{ child.title }}</a>
                  {%- endif -%}
                {%- endfor -%}
              </div>
            </div>
          {%- else -%}
            <a class="dad-drawer__link dad-drawer__toplink" href="{{ link.url }}">{{ link.title }}</a>
          {%- endif -%}
        {%- endfor -%}
      </nav>
    </aside>
  </div>
</dad-header>

{% stylesheet %}
.dad-header { display: block; position: relative; z-index: 30; background: var(--dad-white); border-bottom: 1px solid var(--dad-rule); font-family: var(--font-body); }
.dad-header[data-sticky="true"] { position: sticky; top: 0; }
.dad-header__bar { display: grid; grid-template-columns: 1fr auto 1fr; align-items: center; gap: var(--s-4); padding: var(--s-4) var(--s-5); max-width: 1400px; margin: 0 auto; }
.dad-header__logo { justify-self: start; display: inline-flex; align-items: center; text-decoration: none; }
.dad-header__logo-text { font-family: var(--font-display); font-size: var(--fs-h3); color: var(--dad-ink); }
.dad-header__logo-img { display: block; max-height: 56px; }
.dad-header__nav { justify-self: center; display: flex; align-items: center; gap: var(--s-6); }
.dad-header__nav-item { position: static; }
.dad-header__nav-link { display: inline-flex; align-items: center; gap: 6px; background: none; border: 0; cursor: pointer; font-family: var(--font-body); font-weight: 700; font-size: var(--fs-h4); color: var(--dad-ink); padding: var(--s-2) var(--s-1); text-decoration: none; transition: color var(--dur-fast) var(--ease-out); }
.dad-header__nav-link:hover, .dad-header__nav-item[data-open] .dad-header__nav-link { color: var(--dad-brand-red); }
.dad-header__caret { transition: transform var(--dur-fast) var(--ease-out); }
.dad-header__nav-item[data-open] .dad-header__caret { transform: rotate(180deg); }
.dad-header__actions { justify-self: end; display: flex; align-items: center; gap: var(--s-3); }
.dad-header__icon { display: inline-flex; align-items: center; justify-content: center; width: 44px; height: 44px; border: 0; background: none; cursor: pointer; color: var(--dad-ink); border-radius: var(--r-pill); text-decoration: none; transition: background var(--dur-fast) var(--ease-out), color var(--dur-fast) var(--ease-out); }
.dad-header__icon:hover { background: var(--dad-sky-tint); color: var(--dad-brand-red); }
.dad-header__cart { position: relative; }
.dad-header__cart-count { position: absolute; top: 4px; right: 4px; min-width: 18px; height: 18px; padding: 0 4px; display: inline-flex; align-items: center; justify-content: center; background: var(--dad-brand-red); color: #fff; font-size: 11px; font-weight: 700; border-radius: var(--r-pill); }
.dad-header__cart-count.is-empty { display: none; }
.dad-header__burger { display: none; }

/* Mega panel — Graza layout: text columns + featured row */
.dad-mega { position: absolute; left: 0; right: 0; top: 100%; background: var(--dad-white); border-top: 1px solid var(--dad-rule); box-shadow: var(--shadow-soft); max-height: min(72vh, 540px); overflow-y: auto; overscroll-behavior: contain; }
.dad-mega[hidden], .dad-dropdown[hidden], .dad-drawer[hidden] { display: none; }
.dad-mega__inner { max-width: 1180px; margin: 0 auto; padding: var(--s-8) var(--s-6); }
.dad-mega__layout { display: grid; grid-template-columns: auto minmax(0, 1fr); gap: var(--s-12); align-items: start; }
.dad-mega__cols { display: grid; grid-template-columns: repeat(2, minmax(150px, max-content)); gap: var(--s-6) var(--s-10); }
.dad-mega__col-title { font-family: var(--font-body); font-weight: 700; color: var(--dad-ink-soft); font-size: var(--fs-small); letter-spacing: var(--tracking-allcaps); text-transform: uppercase; margin: 0 0 var(--s-4); }
.dad-mega__sublist { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: var(--s-3); }
.dad-mega__sublist a { text-decoration: none; color: var(--dad-ink); font-weight: 600; font-size: var(--fs-body); transition: color var(--dur-fast) var(--ease-out); }
.dad-mega__sublist a:hover { color: var(--dad-brand-red); }
.dad-mega__featured-row { display: grid; grid-template-columns: repeat(auto-fit, minmax(120px, 1fr)); gap: var(--s-5); }
.dad-mega__fcard { display: flex; flex-direction: column; gap: var(--s-2); text-decoration: none; color: var(--dad-ink); text-align: center; }
.dad-mega__fcard-media { display: block; overflow: hidden; border-radius: var(--r-md); background: var(--dad-sky-tint); height: clamp(110px, 10vw, 150px); }
.dad-mega__fcard-img { width: 100%; height: 100%; object-fit: cover; display: block; transition: transform var(--dur-med) var(--ease-out); }
.dad-mega__fcard:hover .dad-mega__fcard-img { transform: scale(1.05); }
.dad-mega__fcard-cap { font-family: var(--font-display); font-size: var(--fs-h4); line-height: var(--lh-snug); }
.dad-mega__fcard:hover .dad-mega__fcard-cap { color: var(--dad-brand-red); }
@media screen and (max-width: 1040px) {
  .dad-mega__layout { grid-template-columns: 1fr; gap: var(--s-8); }
}

/* Resources dropdown */
.dad-dropdown { position: absolute; top: 100%; background: var(--dad-white); border: 1px solid var(--dad-rule); border-radius: var(--r-md); box-shadow: var(--shadow-soft); padding: var(--s-3); min-width: 200px; margin-top: -1px; }
.dad-dropdown__list { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; }
.dad-dropdown__list a { display: block; text-decoration: none; color: var(--dad-ink); font-weight: 600; padding: var(--s-2) var(--s-3); border-radius: var(--r-sm); transition: background var(--dur-fast) var(--ease-out), color var(--dur-fast) var(--ease-out); }
.dad-dropdown__list a:hover { background: var(--dad-sky-tint); color: var(--dad-brand-red); }

/* Mobile drawer */
.dad-drawer { position: fixed; inset: 0; z-index: 60; }
.dad-drawer__overlay { position: absolute; inset: 0; background: rgba(43,42,45,0.5); }
.dad-drawer__panel { position: absolute; top: 0; left: 0; bottom: 0; width: min(86vw, 360px); background: var(--dad-white); padding: var(--s-6) var(--s-5); overflow-y: auto; box-shadow: var(--shadow-soft); }
.dad-drawer__close { margin-left: auto; }
.dad-drawer__nav { margin-top: var(--s-4); display: flex; flex-direction: column; gap: var(--s-2); }
.dad-drawer__toggle, .dad-drawer__toplink { display: flex; justify-content: space-between; align-items: center; width: 100%; background: none; border: 0; cursor: pointer; font-family: var(--font-display); font-size: var(--fs-h3); color: var(--dad-ink); padding: var(--s-3) 0; border-bottom: 1px solid var(--dad-rule); text-decoration: none; }
.dad-drawer__sub { display: flex; flex-direction: column; gap: var(--s-1); padding: var(--s-3) 0 var(--s-4) var(--s-3); }
.dad-drawer__sub[hidden] { display: none; }
.dad-drawer__link { text-decoration: none; color: var(--dad-ink-muted); font-weight: 600; font-size: var(--fs-body); padding: var(--s-2) 0; }
.dad-drawer__link:hover { color: var(--dad-brand-red); }

@media screen and (max-width: 989px) {
  .dad-header__nav { display: none; }
  .dad-header__burger { display: inline-flex; justify-self: start; }
  .dad-header__logo { justify-self: center; }
}
@media screen and (min-width: 990px) {
  .dad-drawer { display: none !important; }
}
{% endstylesheet %}

{% javascript %}
class DadHeader extends HTMLElement {
  constructor() {
    super();
    this.items = Array.from(this.querySelectorAll('[data-nav-item]'));
    this.closeTimer = null;
    this.init();
  }
  init() {
    this.items.forEach((item) => {
      const trigger = item.querySelector('[data-nav-trigger]');
      const panel = item.querySelector('[data-nav-panel]');
      if (!trigger || !panel) return;
      item.addEventListener('mouseenter', () => this.open(item));
      item.addEventListener('mouseleave', () => this.scheduleClose(item));
      trigger.addEventListener('click', (e) => { e.preventDefault(); this.toggle(item); });
      trigger.addEventListener('keydown', (e) => { if (e.key === 'Escape') this.close(item); });
    });
    document.addEventListener('keydown', (e) => { if (e.key === 'Escape') this.closeAll(); });
    document.addEventListener('click', (e) => { if (!this.contains(e.target)) this.closeAll(); });

    this.drawer = this.querySelector('[data-drawer]');
    const burger = this.querySelector('[data-drawer-toggle]');
    if (burger && this.drawer) {
      burger.addEventListener('click', () => this.openDrawer());
      this.drawer.querySelectorAll('[data-drawer-close]').forEach((el) => el.addEventListener('click', () => this.closeDrawer()));
      this.drawer.querySelectorAll('[data-drawer-sub]').forEach((btn) => {
        btn.addEventListener('click', () => {
          const sub = btn.nextElementSibling;
          const open = btn.getAttribute('aria-expanded') === 'true';
          btn.setAttribute('aria-expanded', String(!open));
          if (sub) sub.hidden = open;
        });
      });
    }
  }
  open(item) {
    clearTimeout(this.closeTimer);
    this.items.forEach((other) => { if (other !== item) this.close(other); });
    item.setAttribute('data-open', '');
    item.querySelector('[data-nav-trigger]').setAttribute('aria-expanded', 'true');
    item.querySelector('[data-nav-panel]').hidden = false;
  }
  close(item) {
    item.removeAttribute('data-open');
    const t = item.querySelector('[data-nav-trigger]');
    const p = item.querySelector('[data-nav-panel]');
    if (t) t.setAttribute('aria-expanded', 'false');
    if (p) p.hidden = true;
  }
  toggle(item) { item.hasAttribute('data-open') ? this.close(item) : this.open(item); }
  scheduleClose(item) { this.closeTimer = setTimeout(() => this.close(item), 180); }
  closeAll() { this.items.forEach((i) => this.close(i)); }
  openDrawer() { if (this.drawer) { this.drawer.hidden = false; document.body.style.overflow = 'hidden'; } }
  closeDrawer() { if (this.drawer) { this.drawer.hidden = true; document.body.style.overflow = ''; } }
}
if (!customElements.get('dad-header')) customElements.define('dad-header', DadHeader);
{% endjavascript %}

{% schema %}
{
  "name": "DAD header",
  "tag": "header",
  "class": "dad-header-section",
  "settings": [
    { "type": "image_picker", "id": "logo", "label": "Logo" },
    { "type": "link_list", "id": "menu", "label": "Menu", "default": "main-menu", "info": "Top-level items become nav links. The item named below becomes the mega menu." },
    { "type": "text", "id": "mega_item", "label": "Mega menu item (by title)", "default": "Shop" },
    { "type": "text", "id": "featured_group", "label": "Featured group (by title)", "default": "Featured", "info": "Inside the mega item, this child group renders as image cards instead of a text column." },
    { "type": "checkbox", "id": "enable_sticky", "label": "Sticky header", "default": true },
    { "type": "checkbox", "id": "show_search", "label": "Show search icon", "default": true }
  ]
}
{% endschema %}
