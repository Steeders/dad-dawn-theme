{%- comment -%}
  Do-A-Dot Art — Home hero. Ported from design components/home.jsx hero,
  layout="image" (full-bleed lifestyle photo + frosted-white copy card).
{%- endcomment -%}

<section class="dad-hero{% if section.settings.mobile_layout != 'overlay' %} dad-hero--stack-mobile{% endif %}" style="
  {%- if section.settings.min_height_desktop -%}--dad-hero-min-h-desktop: {{ section.settings.min_height_desktop }}px;{%- endif -%}
  {%- if section.settings.min_height_mobile -%}--dad-hero-min-h-mobile: {{ section.settings.min_height_mobile }}px;{%- endif -%}
  --dad-hero-card-opacity: {{ section.settings.card_bg_opacity | default: 88 | divided_by: 100.0 }};
  --dad-hero-card-align: {{ section.settings.card_position | default: 'center' }};
  --dad-hero-mobile-ratio: {{ section.settings.mobile_image_ratio | default: '5 / 4' }};
">
  <div class="dad-hero__photo">
    {%- if section.settings.media_type == 'video' -%}
      {%- if section.settings.video != null -%}
        {{ section.settings.video | video_tag:
          image_size: '1600x',
          autoplay: true,
          loop: true,
          muted: true,
          controls: false,
          playsinline: true
        }}
      {%- else -%}
        <div class="dad-hero__photo-placeholder">Upload a hero video in the customizer</div>
      {%- endif -%}
    {%- elsif section.settings.image != blank -%}
      {%- liquid
        assign hero_alt = section.settings.image.alt | default: section.settings.heading | escape
        assign desktop_class = ''
        assign desktop_sizes = '100vw'
        if section.settings.mobile_image != blank
          assign desktop_class = 'dad-hero__img--desktop'
          assign desktop_sizes = '(max-width: 989px) 1px, 100vw'
          assign mobile_alt = section.settings.mobile_image.alt | default: hero_alt
        endif
      -%}
      {{ section.settings.image | image_url: width: 2400 | image_tag:
        loading: 'eager',
        fetchpriority: 'high',
        widths: '600,900,1200,1600,2000,2400',
        sizes: desktop_sizes,
        class: desktop_class,
        alt: hero_alt
      }}
      {%- if section.settings.mobile_image != blank -%}
        {{ section.settings.mobile_image | image_url: width: 1600 | image_tag:
          loading: 'eager',
          widths: '600,900,1200,1600',
          sizes: '(max-width: 989px) 100vw, 1px',
          class: 'dad-hero__img--mobile',
          alt: mobile_alt
        }}
      {%- endif -%}
    {%- else -%}
      <div class="dad-hero__photo-placeholder">Upload a hero image in the customizer</div>
    {%- endif -%}
  </div>

  <div class="dad-hero__inner page-width">
    <div class="dad-hero__card">
      {%- if section.settings.eyebrow != blank -%}
        <span class="dad-hero__eyebrow">{{ section.settings.eyebrow }}</span>
      {%- endif -%}

      <h1 class="dad-hero__heading">
        {{ section.settings.heading }}
        {%- if section.settings.script_accent != blank -%}
          <span class="dad-hero__script">{{ section.settings.script_accent }}</span>
        {%- endif -%}
      </h1>

      {%- if section.settings.lede != blank -%}
        <p class="dad-hero__lede">{{ section.settings.lede }}</p>
      {%- endif -%}

      {%- if section.settings.btn1_label != blank or section.settings.btn2_label != blank -%}
        <div class="dad-hero__actions">
          {%- if section.settings.btn1_label != blank -%}
            <a href="{{ section.settings.btn1_link | default: '#' }}" class="dad-hero__btn dad-hero__btn--primary">
              <span>{{ section.settings.btn1_label }}</span>
              <span class="dad-hero__btn-arrow" aria-hidden="true">→</span>
            </a>
          {%- endif -%}
          {%- if section.settings.btn2_label != blank -%}
            <a href="{{ section.settings.btn2_link | default: '#' }}" class="dad-hero__btn dad-hero__btn--ghost">
              {{ section.settings.btn2_label }}
            </a>
          {%- endif -%}
        </div>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Do-A-Dot Hero",
  "tag": "section",
  "class": "dad-hero-wrapper",
  "settings": [
    {
      "type": "select",
      "id": "media_type",
      "label": "Background media",
      "options": [
        { "value": "image", "label": "Image" },
        { "value": "video", "label": "Video" }
      ],
      "default": "image",
      "info": "Video plays muted, looped, full-bleed — like a moving background photo."
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Background image",
      "info": "Lifestyle photo, full-bleed. Recommend 2400px wide. Used when Background media is set to Image."
    },
    {
      "type": "video",
      "id": "video",
      "label": "Background video",
      "info": "Shopify-hosted video. Used when Background media is set to Video."
    },
    {
      "type": "range",
      "id": "min_height_desktop",
      "label": "Minimum height (desktop)",
      "min": 360,
      "max": 900,
      "step": 20,
      "default": 720,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "min_height_mobile",
      "label": "Minimum height (mobile)",
      "min": 320,
      "max": 700,
      "step": 20,
      "default": 480,
      "unit": "px"
    },
    {
      "type": "header",
      "content": "Mobile"
    },
    {
      "type": "select",
      "id": "mobile_layout",
      "label": "Mobile layout",
      "options": [
        { "value": "stack", "label": "Photo on top, text below" },
        { "value": "overlay", "label": "Text card over photo" }
      ],
      "default": "stack",
      "info": "Photo on top keeps the kids visible on phones."
    },
    {
      "type": "select",
      "id": "mobile_image_ratio",
      "label": "Mobile photo shape",
      "options": [
        { "value": "1 / 1", "label": "Square" },
        { "value": "5 / 4", "label": "Slightly wide (5:4)" },
        { "value": "4 / 3", "label": "Wide (4:3)" },
        { "value": "3 / 2", "label": "Extra wide (3:2)" },
        { "value": "4 / 5", "label": "Tall (4:5)" }
      ],
      "default": "5 / 4",
      "info": "Only used with Photo on top. Set the image's focal point so the crop keeps the kids and product in frame."
    },
    {
      "type": "image_picker",
      "id": "mobile_image",
      "label": "Mobile image (optional)",
      "info": "A different crop or photo for phones. Leave empty to reuse the background image."
    },
    {
      "type": "header",
      "content": "Card appearance"
    },
    {
      "type": "range",
      "id": "card_bg_opacity",
      "label": "Card background opacity",
      "min": 0,
      "max": 100,
      "step": 4,
      "default": 88,
      "unit": "%",
      "info": "0 removes the white card background entirely, leaving just the text over the media."
    },
    {
      "type": "select",
      "id": "card_position",
      "label": "Card vertical position",
      "options": [
        { "value": "flex-start", "label": "Top" },
        { "value": "center", "label": "Center" },
        { "value": "flex-end", "label": "Bottom" }
      ],
      "default": "center"
    },
    {
      "type": "header",
      "content": "Copy"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "the whole craft closet"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Made for little hands. Loved by"
    },
    {
      "type": "text",
      "id": "script_accent",
      "label": "Script accent (appears under heading in pink)",
      "default": "big imaginations."
    },
    {
      "type": "textarea",
      "id": "lede",
      "label": "Lede",
      "default": "Markers, watercolors, and chunky crayons: the whole craft closet, shipped direct from the family that's been making mess-free art easier for nearly four decades."
    },
    {
      "type": "header",
      "content": "Buttons"
    },
    {
      "type": "text",
      "id": "btn1_label",
      "label": "Primary button label",
      "default": "shop all"
    },
    {
      "type": "url",
      "id": "btn1_link",
      "label": "Primary button link"
    },
    {
      "type": "text",
      "id": "btn2_label",
      "label": "Ghost button label",
      "default": "meet the colors"
    },
    {
      "type": "url",
      "id": "btn2_link",
      "label": "Ghost button link"
    }
  ],
  "presets": [
    {
      "name": "Do-A-Dot Hero"
    }
  ]
}
{% endschema %}
