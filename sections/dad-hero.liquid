{%- comment -%}
  Do-A-Dot Art — Home hero. Ported from design components/home.jsx hero,
  layout="image" (full-bleed lifestyle photo + frosted-white copy card).
{%- endcomment -%}

{%- liquid
  comment
    Seasonal colors: each picker is optional. Blank or transparent means
    "use the brand color", so an untouched section renders exactly as before.
  endcomment
  assign season_vars = ''
  assign color_keys = 'eyebrow,heading,script,lede,btn1_bg,btn1_text,btn2_bg,btn2_text' | split: ','
  for k in color_keys
    assign key = 'color_' | append: k
    assign c = section.settings[key]
    if c != blank and c.alpha != 0.0
      assign css_key = k | replace: '_', '-'
      assign season_vars = season_vars | append: '--dad-hero-c-' | append: css_key | append: ':' | append: c | append: ';'
      if k == 'btn1_bg'
        assign shade = c | color_darken: 18
        assign season_vars = season_vars | append: '--dad-hero-c-btn1-shadow:' | append: shade | append: ';'
      endif
    endif
  endfor
  if section.settings.heading_font_mode == 'custom' and section.settings.heading_font != blank
    assign f = section.settings.heading_font
    assign season_vars = season_vars | append: '--dad-hero-font-heading:' | append: f.family | append: ', ' | append: f.fallback_families | append: ';--dad-hero-font-heading-weight:' | append: f.weight | append: ';--dad-hero-font-heading-style:' | append: f.style | append: ';'
  endif
  if section.settings.script_font_mode == 'custom' and section.settings.script_font != blank
    assign f = section.settings.script_font
    assign season_vars = season_vars | append: '--dad-hero-font-script:' | append: f.family | append: ', ' | append: f.fallback_families | append: ';--dad-hero-font-script-weight:' | append: f.weight | append: ';--dad-hero-font-script-style:' | append: f.style | append: ';'
  endif
-%}
{%- if season_vars != blank -%}
  {%- comment -%} Font families carry quotes, so these live in a style block, not the style attribute. {%- endcomment -%}
  <style>
    {%- if section.settings.heading_font_mode == 'custom' and section.settings.heading_font != blank -%}
      {{ section.settings.heading_font | font_face: font_display: 'swap' }}
    {%- endif -%}
    {%- if section.settings.script_font_mode == 'custom' and section.settings.script_font != blank -%}
      {{ section.settings.script_font | font_face: font_display: 'swap' }}
    {%- endif -%}
    #shopify-section-{{ section.id }} .dad-hero { {{ season_vars }} }
  </style>
{%- endif -%}

<section class="dad-hero{% if section.settings.mobile_layout != 'overlay' %} dad-hero--stack-mobile{% endif %}{% if section.settings.desktop_layout != blank and section.settings.desktop_layout != 'card' %} dad-hero--desk-{{ section.settings.desktop_layout }}{% endif %}{% if section.settings.card_bg_opacity == 0 %} dad-hero--no-card{% endif %}{% if section.settings.text_backdrop != blank and section.settings.text_backdrop != 'none' %} dad-hero--text-{{ section.settings.text_backdrop }}{% endif %}" style="
  {%- if section.settings.min_height_desktop -%}--dad-hero-min-h-desktop: {{ section.settings.min_height_desktop }}px;{%- endif -%}
  {%- if section.settings.min_height_mobile -%}--dad-hero-min-h-mobile: {{ section.settings.min_height_mobile }}px;{%- endif -%}
  --dad-hero-card-opacity: {{ section.settings.card_bg_opacity | default: 88 | divided_by: 100.0 }};
  --dad-hero-card-align: {{ section.settings.card_position | default: 'center' }};
  --dad-hero-mobile-ratio: {{ section.settings.mobile_image_ratio | default: '5 / 4' }};
">
  <div class="dad-hero__photo">
    {%- if section.settings.media_type == 'video' -%}
      {%- if section.settings.video != null -%}
        {{ section.settings.video | video_tag:
          image_size: '1600x',
          autoplay: true,
          loop: true,
          muted: true,
          controls: false,
          playsinline: true
        }}
      {%- else -%}
        <div class="dad-hero__photo-placeholder">Upload a hero video in the customizer</div>
      {%- endif -%}
    {%- elsif section.settings.image != blank -%}
      {%- liquid
        assign hero_alt = section.settings.image.alt | default: section.settings.heading | escape
        assign desktop_class = ''
        assign desktop_sizes = '100vw'
        if section.settings.mobile_image != blank
          assign desktop_class = 'dad-hero__img--desktop'
          assign desktop_sizes = '(max-width: 989px) 1px, 100vw'
          assign mobile_alt = section.settings.mobile_image.alt | default: hero_alt
        endif
      -%}
      {{ section.settings.image | image_url: width: 2400 | image_tag:
        loading: 'eager',
        fetchpriority: 'high',
        widths: '600,900,1200,1600,2000,2400',
        sizes: desktop_sizes,
        class: desktop_class,
        alt: hero_alt
      }}
      {%- if section.settings.mobile_image != blank -%}
        {{ section.settings.mobile_image | image_url: width: 1600 | image_tag:
          loading: 'eager',
          widths: '600,900,1200,1600',
          sizes: '(max-width: 989px) 100vw, 1px',
          class: 'dad-hero__img--mobile',
          alt: mobile_alt
        }}
      {%- endif -%}
    {%- else -%}
      <div class="dad-hero__photo-placeholder">Upload a hero image in the customizer</div>
    {%- endif -%}
  </div>

  <div class="dad-hero__inner page-width">
    <div class="dad-hero__card">
      <div class="dad-hero__copy">
      {%- if section.settings.eyebrow != blank -%}
        <span class="dad-hero__eyebrow">{{ section.settings.eyebrow }}</span>
      {%- endif -%}

      <h1 class="dad-hero__heading">
        {{ section.settings.heading }}
        {%- if section.settings.script_accent != blank -%}
          <span class="dad-hero__script">{{ section.settings.script_accent }}</span>
        {%- endif -%}
      </h1>
      </div>

      <div class="dad-hero__meta">
      {%- if section.settings.lede != blank -%}
        <p class="dad-hero__lede">{{ section.settings.lede }}</p>
      {%- endif -%}

      {%- if section.settings.btn1_label != blank or section.settings.btn2_label != blank -%}
        <div class="dad-hero__actions">
          {%- if section.settings.btn1_label != blank -%}
            <a href="{{ section.settings.btn1_link | default: '#' }}" class="dad-hero__btn dad-hero__btn--primary">
              <span>{{ section.settings.btn1_label }}</span>
              <span class="dad-hero__btn-arrow" aria-hidden="true">→</span>
            </a>
          {%- endif -%}
          {%- if section.settings.btn2_label != blank -%}
            <a href="{{ section.settings.btn2_link | default: '#' }}" class="dad-hero__btn dad-hero__btn--ghost">
              {{ section.settings.btn2_label }}
            </a>
          {%- endif -%}
        </div>
      {%- endif -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Do-A-Dot Hero",
  "tag": "section",
  "class": "dad-hero-wrapper",
  "settings": [
    {
      "type": "select",
      "id": "media_type",
      "label": "Background media",
      "options": [
        { "value": "image", "label": "Image" },
        { "value": "video", "label": "Video" }
      ],
      "default": "image",
      "info": "Video plays muted, looped, full-bleed — like a moving background photo."
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Background image",
      "info": "Lifestyle photo, full-bleed. Recommend 2400px wide. Used when Background media is set to Image."
    },
    {
      "type": "video",
      "id": "video",
      "label": "Background video",
      "info": "Shopify-hosted video. Used when Background media is set to Video."
    },
    {
      "type": "range",
      "id": "min_height_desktop",
      "label": "Minimum height (desktop)",
      "min": 360,
      "max": 900,
      "step": 20,
      "default": 720,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "min_height_mobile",
      "label": "Minimum height (mobile)",
      "min": 320,
      "max": 700,
      "step": 20,
      "default": 480,
      "unit": "px"
    },
    {
      "type": "header",
      "content": "Desktop layout"
    },
    {
      "type": "select",
      "id": "desktop_layout",
      "label": "Where the text sits (desktop only)",
      "options": [
        { "value": "card", "label": "Text card over photo" },
        { "value": "band", "label": "Strip along the bottom" },
        { "value": "split", "label": "Text left, photo right" },
        { "value": "scrim", "label": "Text over a darkened top" },
        { "value": "corner", "label": "Small card in the bottom corner" }
      ],
      "default": "card",
      "info": "Pick whichever keeps faces clear for this photo. Mobile is not affected. To change the crop, set the photo's focal point under Content → Files."
    },
    {
      "type": "header",
      "content": "Mobile"
    },
    {
      "type": "select",
      "id": "mobile_layout",
      "label": "Mobile layout",
      "options": [
        { "value": "stack", "label": "Photo on top, text below" },
        { "value": "overlay", "label": "Text card over photo" }
      ],
      "default": "stack",
      "info": "Photo on top keeps the kids visible on phones."
    },
    {
      "type": "select",
      "id": "mobile_image_ratio",
      "label": "Mobile photo shape",
      "options": [
        { "value": "1 / 1", "label": "Square" },
        { "value": "5 / 4", "label": "Slightly wide (5:4)" },
        { "value": "4 / 3", "label": "Wide (4:3)" },
        { "value": "3 / 2", "label": "Extra wide (3:2)" },
        { "value": "4 / 5", "label": "Tall (4:5)" }
      ],
      "default": "5 / 4",
      "info": "Only used with Photo on top. Set the image's focal point so the crop keeps the kids and product in frame."
    },
    {
      "type": "image_picker",
      "id": "mobile_image",
      "label": "Mobile image (optional)",
      "info": "A different crop or photo for phones. Leave empty to reuse the background image."
    },
    {
      "type": "header",
      "content": "Seasonal colors",
      "info": "Leave a color empty (or transparent) to use the brand default."
    },
    { "type": "color", "id": "color_eyebrow", "label": "Eyebrow" },
    { "type": "color", "id": "color_heading", "label": "Heading" },
    { "type": "color", "id": "color_script", "label": "Script accent" },
    { "type": "color", "id": "color_lede", "label": "Lede" },
    { "type": "color", "id": "color_btn1_bg", "label": "Primary button" },
    { "type": "color", "id": "color_btn1_text", "label": "Primary button text" },
    { "type": "color", "id": "color_btn2_bg", "label": "Ghost button" },
    { "type": "color", "id": "color_btn2_text", "label": "Ghost button text and outline" },
    {
      "type": "select",
      "id": "text_backdrop",
      "label": "Help the text stand out",
      "options": [
        { "value": "none", "label": "No" },
        { "value": "shadow", "label": "Soft dark shadow (for light text)" },
        { "value": "glow", "label": "Soft light glow (for dark text)" }
      ],
      "default": "none",
      "info": "Useful when the card background is turned off and the text sits straight on the photo."
    },
    {
      "type": "header",
      "content": "Seasonal fonts"
    },
    {
      "type": "select",
      "id": "heading_font_mode",
      "label": "Heading font",
      "options": [
        { "value": "brand", "label": "Brand (Dimbo)" },
        { "value": "custom", "label": "Pick one below" }
      ],
      "default": "brand"
    },
    {
      "type": "font_picker",
      "id": "heading_font",
      "label": "Seasonal heading font",
      "default": "assistant_n4",
      "info": "Only used when Heading font is set to Pick one below."
    },
    {
      "type": "select",
      "id": "script_font_mode",
      "label": "Script accent font",
      "options": [
        { "value": "brand", "label": "Brand (Kids Script)" },
        { "value": "custom", "label": "Pick one below" }
      ],
      "default": "brand"
    },
    {
      "type": "font_picker",
      "id": "script_font",
      "label": "Seasonal script font",
      "default": "assistant_n4",
      "info": "Only used when Script accent font is set to Pick one below."
    },
    {
      "type": "header",
      "content": "Card appearance"
    },
    {
      "type": "range",
      "id": "card_bg_opacity",
      "label": "Card background opacity",
      "min": 0,
      "max": 100,
      "step": 4,
      "default": 88,
      "unit": "%",
      "info": "0 removes the white background and the blur entirely, leaving just the text over the media."
    },
    {
      "type": "select",
      "id": "card_position",
      "label": "Card vertical position",
      "options": [
        { "value": "flex-start", "label": "Top" },
        { "value": "center", "label": "Center" },
        { "value": "flex-end", "label": "Bottom" }
      ],
      "default": "center"
    },
    {
      "type": "header",
      "content": "Copy"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "the whole craft closet"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Made for little hands. Loved by"
    },
    {
      "type": "text",
      "id": "script_accent",
      "label": "Script accent (appears under heading in pink)",
      "default": "big imaginations."
    },
    {
      "type": "textarea",
      "id": "lede",
      "label": "Lede",
      "default": "Markers, watercolors, and chunky crayons: the whole craft closet, shipped direct from the family that's been making mess-free art easier for nearly four decades."
    },
    {
      "type": "header",
      "content": "Buttons"
    },
    {
      "type": "text",
      "id": "btn1_label",
      "label": "Primary button label",
      "default": "shop all"
    },
    {
      "type": "url",
      "id": "btn1_link",
      "label": "Primary button link"
    },
    {
      "type": "text",
      "id": "btn2_label",
      "label": "Ghost button label",
      "default": "meet the colors"
    },
    {
      "type": "url",
      "id": "btn2_link",
      "label": "Ghost button link"
    }
  ],
  "presets": [
    {
      "name": "Do-A-Dot Hero"
    }
  ]
}
{% endschema %}
