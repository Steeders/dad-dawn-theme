{%- comment -%}
  Do-A-Dot free printables email gate.
  Preferred path: a Klaviyo embedded form (klaviyo_form_id) so signups enter
  the welcome series and show up in Klaviyo form analytics like the footer.
  On submit the theme also adds the email to the Free Printables list and
  redirects to the archive. Fallback (no form id, or Klaviyo blocked): the
  native form below subscribes straight to the Free Printables list.
  Either path also subscribes to the welcome list (klaviyo_welcome_list_id)
  so printables signups enter the welcome series instead of dead-ending on a
  list whose own flow is off.
{%- endcomment -%}

<section class="dad-print-gate">
  <div class="dad-print-gate__card">
    {%- if section.settings.image != blank -%}
      <div class="dad-print-gate__media">
        {{ section.settings.image | image_url: width: 1200 | image_tag: widths: '600, 900, 1200', alt: section.settings.heading }}
      </div>
    {%- endif -%}
    <div class="dad-print-gate__body">
      {%- if section.settings.eyebrow != blank -%}
        <p class="dad-eyebrow">{{ section.settings.eyebrow }}</p>
      {%- endif -%}
      <h1 class="dad-print-gate__heading">{{ section.settings.heading }}</h1>
      {%- if section.settings.body != blank -%}
        <div class="dad-print-gate__text">{{ section.settings.body }}</div>
      {%- endif -%}

      {%- liquid
        assign redirect_url = section.settings.redirect_page | default: '/pages/download-free-printables'
        assign form_id = section.settings.klaviyo_form_id | strip
      -%}
      {%- if form_id != blank -%}
        <div
          class="klaviyo-form-{{ form_id }} dad-print-gate__klaviyo"
          data-dad-printables-klaviyo
          data-form-id="{{ form_id }}"
          data-company-id="{{ section.settings.klaviyo_company_id | escape }}"
          data-list-id="{{ section.settings.klaviyo_list_id | escape }}"
          data-welcome-list-id="{{ section.settings.klaviyo_welcome_list_id | escape }}"
          data-redirect-url="{{ redirect_url }}"
        ></div>
      {%- endif -%}

      <form
        class="dad-print-gate__form"
        data-dad-printables-form
        data-company-id="{{ section.settings.klaviyo_company_id | escape }}"
        data-list-id="{{ section.settings.klaviyo_list_id | escape }}"
        data-welcome-list-id="{{ section.settings.klaviyo_welcome_list_id | escape }}"
        data-redirect-url="{{ redirect_url }}"
        novalidate
        {% if form_id != blank %}hidden{% endif %}
      >
        <div class="dad-print-gate__row">
          <input
            type="email"
            name="email"
            class="dad-print-gate__input"
            placeholder="{{ section.settings.placeholder | default: 'your email' }}"
            aria-label="Email"
            autocomplete="email"
            required
          >
          <button type="submit" class="dad-print-gate__btn">
            <span class="dad-print-gate__btn-label">{{ section.settings.button_label | default: 'get my printables' }}</span>
            <span class="dad-print-gate__btn-busy" hidden>sending…</span>
          </button>
        </div>
        <p class="dad-print-gate__error" role="alert" hidden>Hmm, that didn't work. Double-check your email and try again.</p>
        {%- if section.settings.fine_print != blank -%}
          <p class="dad-print-gate__fine">{{ section.settings.fine_print }}</p>
        {%- endif -%}
      </form>
    </div>
  </div>
</section>

{% javascript %}
  // One client-API subscribe. Used for both the printables list and the
  // welcome list, so a printables signup enters the welcome series too.
  function dadPrintablesSubscribe(companyId, listId, email, opts) {
    if (!listId || !email) return Promise.resolve(null);
    return fetch('https://a.klaviyo.com/client/subscriptions/?company_id=' + encodeURIComponent(companyId), {
      method: 'POST',
      keepalive: !!(opts && opts.keepalive),
      headers: { 'Content-Type': 'application/json', revision: '2025-04-15' },
      body: JSON.stringify({
        data: {
          type: 'subscription',
          attributes: {
            custom_source: 'Free Printables Gate',
            profile: { data: { type: 'profile', attributes: { email: email } } },
          },
          relationships: { list: { data: { type: 'list', id: listId } } },
        },
      }),
    });
  }

  // Klaviyo embed path. The form itself subscribes to the welcome list and
  // redirects; here we (a) mirror the email into the Free Printables list so
  // that list stays the printables audience, (b) remember the unlock, and
  // (c) fall back to the native form if Klaviyo never renders (blocked).
  document.querySelectorAll('[data-dad-printables-klaviyo]').forEach((mount) => {
    const native = mount.parentElement.querySelector('[data-dad-printables-form]');
    const formId = mount.dataset.formId;

    window.addEventListener('klaviyoForms', (event) => {
      const d = event.detail || {};
      if (d.formId !== formId) return;
      if (d.type === 'submit') {
        const email = d.metaData && d.metaData.$email;
        try {
          sessionStorage.setItem('dadPrintablesUnlocked', '1');
        } catch (e) {
          /* storage unavailable */
        }
        if (email) {
          dadPrintablesSubscribe(mount.dataset.companyId, mount.dataset.listId, email, {
            keepalive: true,
          }).catch(() => {});
          dadPrintablesSubscribe(mount.dataset.companyId, mount.dataset.welcomeListId, email, {
            keepalive: true,
          }).catch(() => {});
        }
        // The form's own redirect action normally wins; this covers the case
        // where it doesn't fire.
        setTimeout(() => window.location.assign(mount.dataset.redirectUrl), 1500);
      }
    });

    // Klaviyo blocked or the form unpublished: show the native form instead.
    setTimeout(() => {
      if (!mount.children.length && native) {
        mount.hidden = true;
        native.hidden = false;
      }
    }, 3000);
  });

  document.querySelectorAll('[data-dad-printables-form]').forEach((form) => {
    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      const emailInput = form.querySelector('input[name="email"]');
      const error = form.querySelector('.dad-print-gate__error');
      const btn = form.querySelector('button[type="submit"]');
      const email = (emailInput.value || '').trim();
      error.hidden = true;
      if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) {
        error.hidden = false;
        emailInput.focus();
        return;
      }
      btn.disabled = true;
      btn.querySelector('.dad-print-gate__btn-label').hidden = true;
      btn.querySelector('.dad-print-gate__btn-busy').hidden = false;
      try {
        // Welcome list is fire-and-forget: a failure there must not block the
        // printables unlock, which is what the visitor was actually promised.
        dadPrintablesSubscribe(form.dataset.companyId, form.dataset.welcomeListId, email, {
          keepalive: true,
        }).catch(() => {});
        const res = await dadPrintablesSubscribe(form.dataset.companyId, form.dataset.listId, email);
        if (!res || !res.ok) throw new Error('subscribe failed: ' + (res && res.status));
        try {
          sessionStorage.setItem('dadPrintablesUnlocked', '1');
        } catch (e) {
          /* storage unavailable; redirect regardless */
        }
        window.location.assign(form.dataset.redirectUrl);
      } catch (e) {
        error.hidden = false;
        btn.disabled = false;
        btn.querySelector('.dad-print-gate__btn-label').hidden = false;
        btn.querySelector('.dad-print-gate__btn-busy').hidden = true;
      }
    });
  });
{% endjavascript %}

{% schema %}
{
  "name": "DAD Printables Gate",
  "tag": "section",
  "class": "section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "free printables" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Free printables for every month of the year." },
    { "type": "richtext", "id": "body", "label": "Body" },
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "text", "id": "placeholder", "label": "Email placeholder", "default": "your email" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "get my printables" },
    { "type": "text", "id": "fine_print", "label": "Fine print", "default": "We'll email you new printables as they drop. Unsubscribe anytime." },
    { "type": "header", "content": "Klaviyo" },
    { "type": "text", "id": "klaviyo_form_id", "label": "Klaviyo embedded form ID", "info": "The code after 'klaviyo-form-' on a LIVE embed form. When set, signups go through this form (welcome series + form analytics). Leave blank to use the native form below." },
    { "type": "text", "id": "klaviyo_company_id", "label": "Klaviyo public API key (company id)", "default": "RizdDa" },
    { "type": "text", "id": "klaviyo_list_id", "label": "Klaviyo list id", "default": "TYvDQN", "info": "Free Printables Signups list. Also mirrored on embed-form submits." },
    { "type": "text", "id": "klaviyo_welcome_list_id", "label": "Klaviyo welcome list id", "default": "SfHcwp", "info": "Signups are added here too so they enter the welcome series (RAb5tu). Clear this to stop enrolling printables signups in the welcome series." },
    { "type": "url", "id": "redirect_page", "label": "Redirect to after signup", "info": "Defaults to /pages/download-free-printables" }
  ],
  "presets": [{ "name": "DAD Printables Gate" }]
}
{% endschema %}
