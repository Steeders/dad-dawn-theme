{%- comment -%}
  DAD CATEGORY TILES — Do-A-Dot Art
  Homepage CTA row of category tiles linking to collections. Each tile pulls
  its image/title/link from a linked collection by default, with optional
  per-tile overrides (image_picker, heading, subtext, link). Adaptive images
  via image_tag srcset. New section — update-safe, tokens from dad-tokens.css.
{%- endcomment -%}

<div class="dad-cats color-{{ section.settings.color_scheme }}" style="--cols: {{ section.settings.columns_desktop }}; padding-top: {{ section.settings.padding_top }}px; padding-bottom: {{ section.settings.padding_bottom }}px;">
  <div class="dad-cats__inner">
    {%- if section.settings.heading != blank -%}
      <div class="dad-cats__head">
        <h2 class="dad-cats__title">{{ section.settings.heading }}</h2>
        {%- if section.settings.subheading != blank -%}<p class="dad-cats__sub">{{ section.settings.subheading }}</p>{%- endif -%}
      </div>
    {%- endif -%}

    <div class="dad-cats__grid">
      {%- for block in section.blocks -%}
        {%- liquid
          assign coll = block.settings.collection
          assign turl = block.settings.link
          if turl == blank and coll != blank
            assign turl = coll.url
          endif
          if turl == blank
            assign turl = routes.all_products_collection_url
          endif
          assign tname = block.settings.heading
          if tname == blank and coll != blank
            assign tname = coll.title
          endif
          assign timg = block.settings.image
          if timg == blank and coll != blank and coll.image != blank
            assign timg = coll.image
          endif
          if timg == blank and coll != blank and coll.products.first != blank
            assign timg = coll.products.first.featured_image
          endif
        -%}
        <a class="dad-cat" href="{{ turl }}" {{ block.shopify_attributes }}>
          <span class="dad-cat__media">
            {%- if timg != blank -%}
              {{ timg | image_url: width: 900 | image_tag:
                loading: 'lazy',
                widths: '300, 450, 600, 800, 900',
                sizes: '(max-width: 479px) 92vw, (max-width: 989px) 46vw, 23vw',
                alt: tname,
                class: 'dad-cat__img' }}
            {%- endif -%}
          </span>
          <span class="dad-cat__label">
            <span class="dad-cat__name">{{ tname }}</span>
            <svg class="dad-cat__arrow" viewBox="0 0 16 16" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 8h10M9 4l4 4-4 4"/></svg>
          </span>
          {%- if block.settings.subtext != blank -%}<span class="dad-cat__sub">{{ block.settings.subtext }}</span>{%- endif -%}
        </a>
      {%- endfor -%}
    </div>
  </div>
</div>

{% stylesheet %}
.dad-cats { padding-left: var(--s-5); padding-right: var(--s-5); }
.dad-cats__inner { max-width: 1200px; margin: 0 auto; }
.dad-cats__head { text-align: center; margin-bottom: var(--s-8); }
.dad-cats__title { font-family: var(--font-display); font-weight: 400; font-size: var(--fs-h2); color: var(--dad-ink); margin: 0; }
.dad-cats__sub { font-family: var(--font-body); font-weight: 500; font-size: var(--fs-lead); color: var(--dad-ink-muted); margin: var(--s-2) 0 0; }
.dad-cats__grid { display: grid; grid-template-columns: repeat(var(--cols, 4), minmax(0, 1fr)); gap: var(--s-6); }
.dad-cat { display: flex; flex-direction: column; text-decoration: none; color: var(--dad-ink); text-align: center; }
.dad-cat__media { display: block; overflow: hidden; border-radius: var(--r-lg); background: var(--dad-sky-tint); aspect-ratio: 4 / 5; box-shadow: var(--shadow-soft); }
.dad-cat__img { width: 100%; height: 100%; object-fit: cover; display: block; transition: transform var(--dur-med) var(--ease-out); }
.dad-cat:hover .dad-cat__img { transform: scale(1.04); }
.dad-cat__label { margin-top: var(--s-3); display: flex; align-items: center; justify-content: center; gap: var(--s-2); }
.dad-cat__name { font-family: var(--font-display); font-weight: 400; font-size: var(--fs-h3); line-height: var(--lh-snug); }
.dad-cat:hover .dad-cat__name { color: var(--dad-brand-red); }
.dad-cat__sub { display: block; font-family: var(--font-body); font-weight: 500; font-size: var(--fs-small); color: var(--dad-ink-muted); margin-top: 2px; }
.dad-cat__arrow { flex: none; color: var(--dad-brand-red); transition: transform var(--dur-fast) var(--ease-out); }
.dad-cat:hover .dad-cat__arrow { transform: translateX(4px); }
@media screen and (max-width: 989px) { .dad-cats__grid { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--s-5); } }
@media screen and (max-width: 479px) { .dad-cats__grid { grid-template-columns: 1fr; } }
{% endstylesheet %}

{% schema %}
{
  "name": "DAD category tiles",
  "tag": "section",
  "class": "dad-category-tiles-section",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Shop by category" },
    { "type": "text", "id": "subheading", "label": "Subheading" },
    { "type": "range", "id": "columns_desktop", "min": 2, "max": 5, "step": 1, "label": "Columns (desktop)", "default": 4 },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-1" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 120, "step": 4, "unit": "px", "label": "Top padding", "default": 56 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 120, "step": 4, "unit": "px", "label": "Bottom padding", "default": 56 }
  ],
  "blocks": [
    {
      "type": "tile",
      "name": "Category tile",
      "settings": [
        { "type": "collection", "id": "collection", "label": "Collection", "info": "Used for the link, title, and image when those are left blank." },
        { "type": "image_picker", "id": "image", "label": "Image (overrides collection image)" },
        { "type": "text", "id": "heading", "label": "Title (overrides collection title)" },
        { "type": "text", "id": "subtext", "label": "Subtext" },
        { "type": "url", "id": "link", "label": "Link (overrides collection link)" }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [
    {
      "name": "DAD category tiles",
      "blocks": [
        { "type": "tile" },
        { "type": "tile" },
        { "type": "tile" },
        { "type": "tile" }
      ]
    }
  ]
}
{% endschema %}
