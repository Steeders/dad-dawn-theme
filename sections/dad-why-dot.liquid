{%- comment -%}
  DAD WHY DOT — Do-A-Dot Art
  "Why parents keep coming back" promise grid: eyebrow + heading + a row of
  benefit columns, each led by a painted dot icon, a display title, and body copy.
  Each promise is a BLOCK — editable in the theme editor (dot color or custom
  icon, title, body). New section — update-safe. Drinks from dad-tokens.css.
{%- endcomment -%}

<div
  class="dad-why color-{{ section.settings.color_scheme }}"
  style="padding-top: {{ section.settings.padding_top }}px; padding-bottom: {{ section.settings.padding_bottom }}px;"
>
  <div class="dad-why__inner">
    {%- if section.settings.eyebrow != blank or section.settings.heading != blank -%}
      <div class="dad-why__head">
        {%- if section.settings.eyebrow != blank -%}
          <span class="dad-why__eyebrow">{{ section.settings.eyebrow }}</span>
        {%- endif -%}
        {%- if section.settings.heading != blank -%}
          <h2 class="dad-why__heading">{{ section.settings.heading }}</h2>
        {%- endif -%}
      </div>
    {%- endif -%}

    <div class="dad-why__grid" style="--cols: {{ section.settings.columns }};">
      {%- for block in section.blocks -%}
        <div class="dad-why__item" {{ block.shopify_attributes }}>
          <div class="dad-why__ic">
            {%- if block.settings.icon_image != blank -%}
              {{ block.settings.icon_image | image_url: width: 96 | image_tag: loading: 'lazy', widths: '48, 96', class: 'dad-why__icimg', alt: '' }}
            {%- else -%}
              {%- assign dot_file = 'dot-' | append: block.settings.dot_color | append: '.png' -%}
              <img class="dad-why__icimg" src="{{ dot_file | asset_url }}" width="48" height="48" alt="" loading="lazy">
            {%- endif -%}
          </div>
          {%- if block.settings.title != blank -%}
            <h4 class="dad-why__title">{{ block.settings.title }}</h4>
          {%- endif -%}
          {%- if block.settings.body != blank -%}
            <p class="dad-why__body">{{ block.settings.body }}</p>
          {%- endif -%}
        </div>
      {%- endfor -%}
    </div>
  </div>
</div>

{% stylesheet %}
.dad-why { padding-left: var(--s-5); padding-right: var(--s-5); }
.dad-why__inner { max-width: 1200px; margin: 0 auto; }

.dad-why__head { margin-bottom: var(--s-12); }
.dad-why__eyebrow { display: inline-flex; align-items: center; gap: var(--s-2); font-family: var(--font-body); font-weight: 700; font-size: var(--fs-micro); letter-spacing: var(--tracking-allcaps); color: var(--dad-hot-pink); }
.dad-why__eyebrow::before { content: ""; width: 7px; height: 7px; border-radius: var(--r-pill); background: currentColor; }
.dad-why__heading { font-family: var(--font-display); font-weight: 400; font-size: var(--fs-h2); line-height: var(--lh-tight); color: var(--dad-ink); margin: var(--s-2) 0 0; }

.dad-why__grid { display: grid; grid-template-columns: repeat(var(--cols, 4), 1fr); gap: var(--s-8); }
.dad-why__item { display: flex; flex-direction: column; gap: var(--s-3); padding: var(--s-1) 0; }
.dad-why__ic { width: 48px; height: 48px; display: flex; align-items: center; justify-content: center; }
.dad-why__icimg { width: 100%; height: 100%; object-fit: contain; display: block; }
.dad-why__title { font-family: var(--font-display); font-weight: 400; font-size: var(--fs-h3); line-height: var(--lh-snug); color: var(--dad-ink); margin: var(--s-1) 0 0; }
.dad-why__body { font-family: var(--font-body); font-weight: 500; font-size: var(--fs-small); line-height: var(--lh-normal); color: var(--dad-ink-muted); margin: 0; max-width: 30ch; }

@media screen and (max-width: 989px) {
  .dad-why__grid { grid-template-columns: repeat(2, 1fr); gap: var(--s-8) var(--s-6); }
}
@media screen and (max-width: 480px) {
  .dad-why__grid { grid-template-columns: 1fr; gap: var(--s-6); }
}
{% endstylesheet %}

{% schema %}
{
  "name": "DAD why dot",
  "tag": "section",
  "class": "dad-why-dot-section",
  "max_blocks": 6,
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "why do-a-dot" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Why parents keep coming back." },
    { "type": "range", "id": "columns", "min": 2, "max": 4, "step": 1, "label": "Columns (desktop)", "default": 4 },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-1" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 160, "step": 4, "unit": "px", "label": "Top padding", "default": 80 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 160, "step": 4, "unit": "px", "label": "Bottom padding", "default": 80 }
  ],
  "blocks": [
    {
      "type": "promise",
      "name": "Promise",
      "settings": [
        { "type": "select", "id": "dot_color", "label": "Dot color", "default": "yellow", "options": [
          { "value": "yellow", "label": "Yellow" },
          { "value": "green", "label": "Green" },
          { "value": "pink-small", "label": "Pink" },
          { "value": "blue", "label": "Blue" },
          { "value": "orange", "label": "Orange" }
        ] },
        { "type": "image_picker", "id": "icon_image", "label": "Custom icon (optional, overrides dot color)" },
        { "type": "text", "id": "title", "label": "Title", "default": "Promise" },
        { "type": "textarea", "id": "body", "label": "Body" }
      ]
    }
  ],
  "presets": [
    {
      "name": "DAD why dot",
      "blocks": [
        { "type": "promise", "settings": { "dot_color": "yellow", "title": "Mess-free, parent-proof", "body": "Non-drip sponge tips & wash-out inks. Drop the marker, keep the rug." } },
        { "type": "promise", "settings": { "dot_color": "green", "title": "Non-toxic. Made for ages 1+", "body": "Pediatric-safe formulas. ASTM D-4236 certified. Tested by tiny hands." } },
        { "type": "promise", "settings": { "dot_color": "pink-small", "title": "Built for chubby fingers", "body": "Chunky barrels and grippy bodies sized for the smallest pincer grip." } },
        { "type": "promise", "settings": { "dot_color": "blue", "title": "30 years of tiny artists", "body": "American family business, dot by dot, since 1995. Still us, still here." } }
      ]
    }
  ]
}
{% endschema %}
