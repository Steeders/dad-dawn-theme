{%- comment -%}
  DAD IMAGE STORY — Do-A-Dot Art
  Brand image+text storytelling band: eyebrow (dot label) / display heading /
  body / ghost-pill CTA on one side, a rounded photo on the other. Matches the
  "conversation through color" design language. New section — update-safe,
  tokens only. Used on the PDP; reusable anywhere.
{%- endcomment -%}

<div
  class="dad-istory color-{{ section.settings.color_scheme }}{% if section.settings.image_side == 'left' %} dad-istory--img-left{% endif %}"
  style="padding-top: {{ section.settings.padding_top }}px; padding-bottom: {{ section.settings.padding_bottom }}px;"
>
  <div class="dad-istory__inner">
    <div class="dad-istory__copy">
      {%- if section.settings.eyebrow != blank -%}
        <span class="dad-istory__eyebrow dad-eyebrow">{{ section.settings.eyebrow }}</span>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h2 class="dad-istory__title">{{ section.settings.heading }}</h2>
      {%- endif -%}
      {%- if section.settings.body != blank -%}
        <div class="dad-istory__body rte">{{ section.settings.body }}</div>
      {%- endif -%}
      {%- if section.settings.cta_label != blank -%}
        <a class="dad-istory__cta" href="{{ section.settings.cta_link | default: '#' }}">
          {{ section.settings.cta_label }}
        </a>
      {%- endif -%}
    </div>

    <div class="dad-istory__media">
      {%- if section.settings.image != blank -%}
        {{
          section.settings.image
          | image_url: width: 1400
          | image_tag:
            loading: 'lazy',
            sizes: '(min-width: 750px) 50vw, 100vw',
            widths: '400, 600, 800, 1000, 1200, 1400',
            class: 'dad-istory__img',
            alt: section.settings.image.alt | default: section.settings.heading | escape
        }}
      {%- else -%}
        <div class="dad-istory__img dad-istory__img--placeholder">
          {{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}
        </div>
      {%- endif -%}
    </div>
  </div>
</div>

{% stylesheet %}
.dad-istory { padding-left: var(--s-5); padding-right: var(--s-5); }
.dad-istory__inner {
  max-width: 1200px;
  margin: 0 auto;
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: var(--s-12);
  align-items: center;
}
.dad-istory--img-left .dad-istory__media { order: -1; }

.dad-istory__eyebrow {
  display: inline-flex;
  align-items: center;
  gap: var(--s-2);
  letter-spacing: 0.04em;
  margin-bottom: var(--s-4);
}
.dad-istory__eyebrow::before {
  content: "";
  width: 7px;
  height: 7px;
  border-radius: var(--r-pill);
  background: currentColor;
}
.dad-istory__title {
  font-family: var(--font-display);
  font-weight: 400;
  font-size: var(--fs-display);
  line-height: var(--lh-tight);
  color: var(--dad-ink);
  margin: 0;
}
.dad-istory__body {
  font-family: var(--font-body);
  font-weight: 500;
  font-size: var(--fs-body);
  line-height: var(--lh-normal);
  color: var(--dad-ink-muted);
  margin-top: var(--s-4);
  max-width: 46ch;
}
.dad-istory__body p { margin: 0; }
.dad-istory__body p + p { margin-top: var(--s-3); }

.dad-istory__cta {
  display: inline-flex;
  align-items: center;
  gap: var(--s-2);
  margin-top: var(--s-6);
  padding: 12px 22px;
  border: 1.5px solid var(--dad-ink);
  border-radius: var(--r-pill);
  font-family: var(--font-body);
  font-weight: 700;
  font-size: var(--fs-small);
  color: var(--dad-ink);
  text-decoration: none;
  background: transparent;
  transition: background var(--dur-fast) var(--ease-out),
              color var(--dur-fast) var(--ease-out);
}
.dad-istory__cta:hover { background: var(--dad-ink); color: var(--dad-cream); }

.dad-istory__img {
  display: block;
  width: 100%;
  height: 100%;
  max-height: 480px;
  aspect-ratio: 5 / 4;
  object-fit: cover;
  border-radius: var(--r-xl);
}
.dad-istory__img--placeholder { background: var(--dad-sky-tint); }
.dad-istory__img--placeholder svg { width: 100%; height: 100%; object-fit: cover; }

@media screen and (max-width: 749px) {
  .dad-istory__inner { grid-template-columns: 1fr; gap: var(--s-6); }
  .dad-istory--img-left .dad-istory__media { order: 0; }
  .dad-istory__media { order: -1; }
  .dad-istory__img { max-height: 320px; }
}
{% endstylesheet %}

{% schema %}
{
  "name": "DAD image story",
  "tag": "section",
  "class": "dad-image-story-section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "made for little hands" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Big, mess-free fun for little hands" },
    { "type": "richtext", "id": "body", "label": "Body" },
    { "type": "text", "id": "cta_label", "label": "Button label", "info": "Leave blank to hide the button." },
    { "type": "url", "id": "cta_link", "label": "Button link" },
    { "type": "image_picker", "id": "image", "label": "Image" },
    {
      "type": "select",
      "id": "image_side",
      "label": "Image side (desktop)",
      "options": [
        { "value": "right", "label": "Right" },
        { "value": "left", "label": "Left" }
      ],
      "default": "right"
    },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-1" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 160, "step": 4, "unit": "px", "label": "Top padding", "default": 64 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 160, "step": 4, "unit": "px", "label": "Bottom padding", "default": 64 }
  ],
  "presets": [ { "name": "DAD image story" } ]
}
{% endschema %}
